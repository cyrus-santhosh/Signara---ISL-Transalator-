# Copy to .env and replace the values before running the backend.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30

# Generate a random secret with at least 32 characters.
AUTH_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

# Paths are relative to the backend/ directory unless absolute.
DATABASE_PATH=data/isl.sqlite3
TTS_OUTPUT_DIR=data/audio

# Comma-separated browser origins allowed to call the API and WebSocket.
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# Vite development proxy destination.
VITE_BACKEND_URL=http://127.0.0.1:8000
