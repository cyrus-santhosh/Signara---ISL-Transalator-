# Copy this file to .env and replace placeholders before running the app.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30

# Generate a random secret with at least 32 characters for email/password auth.
AUTH_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters

# Relative paths are resolved from backend/.
DATABASE_PATH=data/isl.sqlite3
TTS_OUTPUT_DIR=data/audio

# Leave empty to use the localhost development origins configured by the backend.
CORS_ORIGINS=

# Vite proxies /api and /ws to this backend by default.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Leave blank to use Vite's same-origin proxy. Set only for a separately hosted frontend.
VITE_API_BASE_URL=

# Optional live SVC recognition threshold (0..1).
SIGNARA_PREDICTION_THRESHOLD=0.65
